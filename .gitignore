# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
media/raw/
media/inspo/

# generated responsive variants (npm run build:images)
/public/media-opt/

# client media: raw originals and working files stay local (public/media holds what the site serves)
/media/raw/
/media/held/
/media/work/
/media/inspo/
/media/blog-sourced/
.claude/

# QA and lab screenshots are large and regenerable; the reports that cite them are kept
/strategy/gates/screens/
/strategy/**/shots/
/strategy/*-lab/**/*.png
/strategy/*-lab/**/*.jpg
/strategy/stage2/**/*.png
/strategy/speed/**/*.png
